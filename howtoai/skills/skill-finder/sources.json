    { "id": "installed-plugins", "type": "plugins-folder", "path": "~/.claude/plugins/cache" },
    { "id": "claude-marketplace", "type": "claude-marketplaces", "path": "~/.claude/plugins/known_marketplaces.json" },
    { "id": "workspace-skills", "type": "skills-folder", "path": ".claude/skills" },
