      "repo": "anthropics/claude-plugins-official",
      "priority": 2
    },
    {
      "id": "anthropic-agent-skills",
      "type": "marketplace",
      "repo": "anthropics/skills",
      "priority": 2
    },
    {
      "id": "claude-directory",
      "type": "directory",
      "path": "~/.claude/plugins/plugin-directory-cache-v2.json",
      "priority": 3
    },
    {
