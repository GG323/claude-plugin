#!/usr/bin/env bash
# Fake docker for dev-deploy test cases: logs every call.
here="$(cd "$(dirname "$0")" && pwd)"
echo "docker $*" >> "$here/calls.log"
case " $* " in
  *" build "*) echo "Successfully built 3f2a9c1d7e44"; for a in "$@"; do :; done; echo "Successfully tagged shop-api:1.0.0" ;;
  *" version"*|*" info"*) echo "Server Version: 28.2.2" ;;
  *" images"*) printf 'REPOSITORY   TAG     IMAGE ID       SIZE\nshop-api     1.0.0   3f2a9c1d7e44   230MB\n' ;;
  *" save "*|*" image "*) echo "saved" ;;
  *) echo "fake docker: no canned answer for: $*" >&2; exit 2 ;;
esac
