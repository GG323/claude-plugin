{
  "name": "local-k8s",
  "technologies": [
    "kubernetes",
    "docker",
    "dotnet"
  ],
  "production": false,
  "tools": [
    "docker",
    "kubectl"
  ],
  "ready": [
    "kubectl --context local-cluster cluster-info"
  ],
  "steps": [
    {
      "id": "build",
      "command": "docker build -t shop-api:1.0.0 .",
      "rollback": "none: builds a local image only"
    },
    {
      "id": "apply",
      "command": "kubectl --context local-cluster apply -f deploy/k8s/",
      "rollback": "kubectl --context local-cluster rollout undo deployment/shop-api",
      "watch": "kubectl --context local-cluster rollout status deployment/shop-api --timeout=120s"
    }
  ],
  "checks": [
    {
      "name": "health",
      "url": "http://localhost:30080/health",
      "expect_status": 200,
      "contains": "ok",
      "retries": 10,
      "wait_seconds": 3
    }
  ],
  "approval_minutes": 30,
  "notes": "Example: a local cluster reached through the kubectl context local-cluster.",
  "start": [
    "none: the cluster runs on its own"
  ]
}
